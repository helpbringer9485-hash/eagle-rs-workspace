      "premium-chevrons.css",
      "test-premium-chevrons.js",
      "README-ICON-AND-CALLS-v3.13.txt",
      "account-menu-layer.css",
      "test-account-menu.js",
      "README-ACCOUNT-MENU-v3.13.1.txt",
      "executive-startup.css",
      "test-executive-startup.js",
      "executive-inbox.css",
      "executive-vault.css",
      "test-executive-vault.js",
      "README-EXECUTIVE-VAULT-v3.16.txt",
      "test-executive-inbox.js",
      "README-EXECUTIVE-INBOX-v3.15.txt",
      "atmospheric-vault.css",
      "theme-assets/**/*",
      "test-atmospheric-vault.js",
      "README-ATMOSPHERIC-VAULT-v3.17.txt",
      "living-smoke.webm",
      "living-smoke.css",
      "theme-assets/desktop-eagle-*.svg",
      "theme-assets/desktop-eagle-*.png",
      "test-living-smoke.js",
      "README-LIVING-SMOKE-v3.18.txt",
      "microsoft-recovery.js",
      "microsoft-recovery.css",
      "microsoft-auth-config.json",
      "test-microsoft-recovery.js",
      "test-microsoft-activation.js",
      "README-MICROSOFT-RECOVERY-v3.19.txt",
      "README-START-HERE-v3.19.txt",
      "README-HOTMAIL-ACTIVATION-v3.19.1.txt",
      "README-HOTMAIL-CONNECT-v3.19.2.txt",
      "test-hotmail-connect.js",
      "README-EASY-HOTMAIL-v3.20.txt",
      "test-easy-hotmail.js",
      "README-SIMPLE-ACCOUNT-RECOVERY-v3.21.txt",
