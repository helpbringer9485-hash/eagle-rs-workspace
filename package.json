      "test-chat-capture.js",
      "test-counts.js",
      "focused-workspace.css",
      "focused-workspace.js",
      "signal-dock.js",
      "signal-dock-ui.js",
      "SignalDock.exe",
      "SignalDock.cs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "eagle-rs.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EAGLE RS Workspace"
    },
    "asarUnpack": [
      "SignalDock.exe"
