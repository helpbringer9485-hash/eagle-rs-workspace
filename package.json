  "private": true,
  "description": "EAGLE RS Workspace with chat screenshot replies, image translation, and corrected account counts.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check microsoft-recovery.js && node --check google-recovery.js && node --check simple-signin.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check test-check.js && node --check test-theme-engine.js && node test-check.js && node test-theme-engine.js && node test-call-center.js && node test-clean-workspace.js && node test-compact-rail.js && node test-true-call-alerts.js && node test-premium-refactor.js && node test-smart-call-desk.js && node test-premium-chevrons.js && node test-account-menu.js && node test-executive-startup.js && node test-executive-inbox.js && node test-executive-vault.js && node test-atmospheric-vault.js && node test-living-smoke.js && node test-microsoft-recovery.js && node test-microsoft-activation.js && node test-hotmail-connect.js && node test-easy-hotmail.js && node test-simple-signin.js && node test-microsoft-browser.js && node test-outlook-email-recovery.js && node test-direct-email-ui.js && node --check screenshot-chat.js && node test-ai-assistant.js && node test-chat-capture.js && node test-counts.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.eaglers.workspace",
    "productName": "EAGLE RS Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "google-recovery.js",
      "google-auth-config.json",
      "simple-signin.css",
      "simple-signin.js",
      "test-simple-signin.js",
      "test-microsoft-browser.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "logo.svg",
      "eagle-rs.ico",
      "package.json",
      "whatsapp-icon.svg",
      "signal-icon.svg",
      "test-check.js",
      "telegram-icon.svg",
      "gemini-emblem.svg",
      "neural-eagle.svg",
      "reference-artwork.jpg",
      "SECURITY-NOTES.txt",
      "theme-engine.css",
      "test-theme-engine.js",
      "README-FIRST.txt",
      "BUILD-WINDOWS.bat",
      "call-center.css",
      "test-call-center.js",
      "clean-workspace.css",
      "test-clean-workspace.js",
      "compact-rail.css",
      "test-compact-rail.js",
